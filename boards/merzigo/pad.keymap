#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

/ {
    behaviors {
        copyp: copy_paste {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp LC(C)>, <&kp LC(V)>;
            mods = <MOD_LCTL>;
        };
        unredo: undo_redo {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp LC(Z)>, <&kp LC(LS(Z))>;
            mods = <MOD_LCTL>;
        };
    };
};

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
                &kp SPACE         // play (encoder press)
                
                &kp ESC
                &kp LC(LS(LS(L)))
                &kp LS(D)
                &kp LC(LS(N6))
                &kp LC(LA(LS(N5)))
                &kp LA(LS(M))

                &kp LC(LS(N7))
                &kp LC(LS(N9))
                &kp LC(LS(N8))
                &kp LC(LS(D))
                &kp LC(LS(L))
                &kp LC(T)

                &kp LC(N1)
                &kp LC(LS(B))
                &kp LC(LS(E))
                &kp LC(LA(LS(N3)))
                &kp LC(LA(LS(P)))
                &kp LC(LA(LS(N3)))

                &kp LC(N)
                &kp RBKT
                &copyp
                &kp LC((LS(I)))
                &kp LEFT
                &kp LC(LA(I))

                &kp LC(LA(LS(END)))
                &kp LS(RBKT)
                &kp LC(LA(LS(H)))
                &unredo
                &kp RIGHT
                &kp LC(LS(LA(A)))

                &kp SPACE
                &lt 3 LC(X)
                &kp LC(LA(LS(N0)))
                &kp LCTRL
            >;
            sensor-bindings = <&inc_dec_kp LEFT RIGHT>; // frame scrub
        };
        layer_1 {
            bindings = <
                                                    &trans 
                &trans &trans &trans    &trans &trans &trans
                &trans &trans &trans    &trans &trans &trans
                &trans &trans &trans    &trans &trans &trans
                &trans &trans &kp LC(V) &trans &trans &trans
                &trans &trans &trans    &trans &trans &trans
                &trans        &trans            &trans &trans
            >;
        };

        layer_2 {
            bindings = <
                                                    &trans 
                &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans
                &trans        &trans        &trans &trans
            >;
        };

        layer_3 {
            bindings = <
                                                    &trans 
                &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4 &trans
                &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans
                &bt BT_CLR        &trans        &trans &bt BT_CLR_ALL
            >;
        };
    };
};
