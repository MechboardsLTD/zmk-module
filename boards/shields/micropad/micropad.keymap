#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

/ {
        keymap {
                compatible = "zmk,keymap";

                default_layer {
                        display-name = "Default Layer";
                        bindings = <
                            &kp A  &kp B &kp C &kp D
                        >;
                };

                extra1 {
                    status = "reserved";
                };

                extra2 {
                    status = "reserved";
                };

                extra3 {
                    status = "reserved";
                };
        };
};